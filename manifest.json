{
  "manifest_version": 2,
  "name": "Doc2X Tag",
  "version": "0.5.0",
  "description": "Auto-adds the M-circle tag to a parent item when a doc2x or parse child note is added.",
  "homepage_url": "https://github.com/huanongfish/zotero-doc2x-tag",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "applications": {
    "zotero": {
      "id": "doc2x-tag@plugin.local",
      "update_url": "https://github.com/huanongfish/zotero-doc2x-tag/releases/latest/download/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.*"
    }
  }
}
